#!/usr/bin/env python3
"""
Required Files Checker for LevelUp Bank Platform Engineering
Validates that baseline structure files exist in repository root.
"""

import os
import sys
from pathlib import Path


def check_required_files():
    """
    Check if all required files exist in the repository root.
    
    Returns:
        bool: True if all files exist, False otherwise
    """
    required_files = [
        'README.md',
        '.gitignore'
    ]
    
    missing_files = []
    repo_root = Path('.')
    
    for file_name in required_files:
        file_path = repo_root / file_name
        if not file_path.exists():
            missing_files.append(file_name)
    
    if missing_files:
        print("❌ Repository structure validation FAILED")
        print("\nMissing required files:")
        for file_name in missing_files:
            print(f"  - {file_name}")
        print("\nPlease ensure all required files are present in the repository root.")
        return False
    
    print("✅ Repository structure validation PASSED")
    print("All required files are present.")
    return True


def main():
    """Main entry point for the file checker."""
    try:
        if check_required_files():
            sys.exit(0)  # Success
        else:
            sys.exit(1)  # Failure
    except Exception as e:
        print(f"❌ Error during file check: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
